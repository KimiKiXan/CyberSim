# ===== CyberSim — example environment file =====
# Copy to `.env` and edit. Loaded by `python-dotenv` if you wire it up.

# ---- Ollama ----
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=granite3.1-dense:latest
OLLAMA_FALLBACK_MODEL=granite3.1-dense:8b
OLLAMA_TEMPERATURE=0.2
OLLAMA_TOP_P=0.9
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT=180
OLLAMA_KEEP_ALIVE=30m

# ---- Server ----
CYBERSIM_HOST=127.0.0.1
CYBERSIM_PORT=8765
CYBERSIM_RELOAD=false

# ---- Agent loop ----
AGENT_MAX_ITERATIONS=25

# ---- Metasploit RPC (optional) ----
# msfrpcd -P <password> -S -a 127.0.0.1
MSFRPC_HOST=127.0.0.1
MSFRPC_PORT=55553
MSFRPC_USER=msf
MSFRPC_PASSWORD=
MSFRPC_SSL=true

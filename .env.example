# ===== CyberSim — example environment file =====
# Copy to `.env` and edit. Loaded by `python-dotenv` if you wire it up.

# ---- Ollama ----
# Defaults tuned for an RTX 4080 Super (16 GB VRAM).
# Qwen 2.5 14B Instruct Q5_K_M fits fully on-GPU (~10 GB) with 16K context.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b-instruct-q5_K_M
OLLAMA_FALLBACK_MODEL=qwen2.5:7b-instruct
OLLAMA_TEMPERATURE=0.1
OLLAMA_TOP_P=0.9
OLLAMA_NUM_CTX=16384
OLLAMA_TIMEOUT=180
OLLAMA_KEEP_ALIVE=60m
# Enable Flash-Attention for additional VRAM savings on long contexts:
OLLAMA_FLASH_ATTENTION=1

# ---- Server ----
# The server binds on this address and the client connects to it. Default
# matches the operator's VPN-assigned host (Radmin / Hamachi-style 26.x.x.x).
# Change to 0.0.0.0 to listen on every interface, or to 127.0.0.1 for
# loopback-only single-host deployments.
SERVER_HOST=localhost
SERVER_PORT=4899
CYBERSIM_RELOAD=false

# ---- Agent loop ----
AGENT_MAX_ITERATIONS=40

# ---- Metasploit RPC (optional) ----
# msfrpcd -P <password> -S -a 127.0.0.1
MSFRPC_HOST=127.0.0.1
MSFRPC_PORT=55553
MSFRPC_USER=msf
MSFRPC_PASSWORD=
MSFRPC_SSL=true
